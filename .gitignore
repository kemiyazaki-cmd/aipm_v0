# =================================================
# General Directory .gitignore
# Note: Common files (*.log, .DS_Store, etc.)
#       are handled by global gitignore
# =================================================

# Temporary files
*.tmp
*.temp
temp/

# Cache
.cache/
*.cache

# Personal/private content
personal/
private/
*.secret

# Project-specific
# (Add project-specific patterns here)

# =================================================
# Generated workspace (created by setup_workspace_simple.sh)
# These are locally bootstrapped dirs and externally cloned
# repos (.cursor/rules, scripts, Stock/programs/*), not part
# of this bootstrap repo. Keep them out of version control.
# =================================================
.cursor/
.vscode/
scripts/
Flow/
Stock/
Archived/
